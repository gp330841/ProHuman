# ==============================================================================
# Conversation Intelligence Platform - Environment Configuration Template
# Copy this file to `.env` and fill in your secrets and configuration values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Global / Shared Infrastructure
# ------------------------------------------------------------------------------
# Database credentials (used by PostgreSQL container and services)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=prohuman
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Shared Database Connection URL (PostgreSQL 16 with pgvector extension)
# Note: In docker-compose, hostname is `postgres` instead of `localhost`
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/prohuman

# Redis URL (used as Celery task broker, results store, and distributed locks)
# Note: In docker-compose, hostname is `redis` instead of `localhost`
REDIS_URL=redis://localhost:6379/0

# MinIO / S3-Compatible Object Storage Credentials
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# S3 Configuration for storing raw audio chunks and exported media files
# Note: In docker-compose, hostname is `http://minio:9000`
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=audio-recordings

# ------------------------------------------------------------------------------
# 2. Third-Party AI / Provider API Keys
# ------------------------------------------------------------------------------
# Deepgram Speech-to-Text API key (required for audio transcription)
# Sign up and get a key at: https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# OpenAI API key (required for LLM features, MOM generation, and embeddings)
# Sign up and get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 3. Gateway Service Configuration (Prefix: GATEWAY_)
# ------------------------------------------------------------------------------
# Database URL override for Gateway service
GATEWAY_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/prohuman

# Redis URL override for Gateway WebSocket / Rate Limiting
GATEWAY_REDIS_URL=redis://localhost:6379/0

# S3 connection settings for audio streaming chunk persistence
GATEWAY_S3_ENDPOINT_URL=http://localhost:9000
GATEWAY_S3_ACCESS_KEY=minioadmin
GATEWAY_S3_SECRET_KEY=minioadmin
GATEWAY_S3_BUCKET_NAME=audio-recordings

# Gateway WebSocket connection limits & heartbeat frequency (seconds)
GATEWAY_MAX_WS_CONNECTIONS=100
GATEWAY_WS_HEARTBEAT_INTERVAL=15

# Gateway API Rate limiting (requests allowed per IP per minute)
GATEWAY_RATE_LIMIT_REQUESTS_PER_MINUTE=100

# Maximum audio chunk payload size in bytes (default: 1 MB)
GATEWAY_MAX_CHUNK_SIZE=1048576

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
GATEWAY_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 4. Worker Service Configuration (Prefix: WORKER_)
# ------------------------------------------------------------------------------
# Database URL override for asynchronous Celery workers
WORKER_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/prohuman

# Celery broker and result backend Redis connection URL
WORKER_REDIS_URL=redis://localhost:6379/0

# S3 connection settings for reading recorded audio chunks & persisting outputs
WORKER_S3_ENDPOINT_URL=http://localhost:9000
WORKER_S3_ACCESS_KEY=minioadmin
WORKER_S3_SECRET_KEY=minioadmin
WORKER_S3_BUCKET_NAME=audio-recordings

# API credentials used by worker tasks
WORKER_DEEPGRAM_API_KEY=your_deepgram_api_key_here
WORKER_OPENAI_API_KEY=your_openai_api_key_here

# LLM Model used for feature extraction (MOM, summary, sentiment, action items)
WORKER_DEFAULT_LLM_MODEL=gpt-4o

# Vector embedding configuration for transcript chunk indexing
WORKER_EMBEDDING_MODEL=text-embedding-3-small
WORKER_EMBEDDING_DIMENSIONS=1536

# Speech-to-Text adapter selection ('deepgram' or custom)
WORKER_STT_PRIMARY_ADAPTER=deepgram
WORKER_STT_FALLBACK_ADAPTER=

# Maximum task retry attempts before dispatching to Dead Letter Queue
WORKER_MAX_RETRIES=3

# ------------------------------------------------------------------------------
# 5. Agent Service Configuration (Prefix: AGENT_)
# ------------------------------------------------------------------------------
# Database URL override for Agent service
AGENT_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/prohuman

# Redis URL for agent session state, caching, and locks
AGENT_REDIS_URL=redis://localhost:6379/0

# Agent reasoning engine settings
AGENT_DEFAULT_LLM_MODEL=gpt-4o
AGENT_EMBEDDING_MODEL=text-embedding-3-small

# Execution loop limits to prevent runaway loops and runaway costs
AGENT_MAX_TOTAL_HOPS=15
AGENT_MAX_HOPS_PER_SUBGOAL=5
AGENT_MAX_PLANNING_ITERATIONS=3
AGENT_MAX_TOOL_RETRIES=2
AGENT_TOOL_TIMEOUT_SECONDS=30.0
AGENT_TOKEN_BUDGET_LIMIT=200000

# OpenTelemetry collector endpoint for distributed tracing
AGENT_OTLP_ENDPOINT=http://localhost:4317

# Comma or JSON-delimited allowlist for external webhook tool executions
AGENT_WEBHOOK_ALLOWLIST=["api.slack.com","hooks.zapier.com"]

# Agent logging level
AGENT_LOG_LEVEL=INFO
