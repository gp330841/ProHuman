{
  "name": "prohuman-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "build:ui": "npm --prefix ../services/web-ui ci && npm --prefix ../services/web-ui run build",
    "deploy": "npm run build:ui && wrangler deploy --secrets-file .env.production",
    "dev": "wrangler dev",
    "typecheck": "wrangler types && tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@cloudflare/containers": "^0.3.7",
    "typescript": "^5.6.3",
    "wrangler": "^4.156.0"
  }
}
